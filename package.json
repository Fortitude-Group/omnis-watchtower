{
  "name": "omnis-watchtower-dev",
  "private": true,
  "type": "module",
  "description": "Development workspace for the Omnis Watchtower Claude Code plugin (src/plugin).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync-types": "node scripts/sync-engine-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:plugin": "claude plugin test src/plugin",
    "validate": "claude plugin validate src/plugin",
    "check": "npm run typecheck && npm test && npm run validate && npm run test:plugin"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
