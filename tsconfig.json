{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "src/plugin/.claude-plugin/types",
    "src/plugin/hooks",
    "src/plugin/core",
    "src/plugin/adapters",
    "src/plugin/types",
    "src/plugin/tests"
  ]
}
